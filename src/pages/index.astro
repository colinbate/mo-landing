---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import MoTracker from '../components/MoTracker.astro';
import Events from '../components/Events.astro';
import About from '../components/About.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { campaign } from '../config/campaign';
import { getPhotos } from '../lib/photos';

const photos = getPhotos();
const latest = photos.at(-1) ?? null;

const shareImage = latest
  ? (await getImage({ src: latest.image, width: 1024, format: 'jpg', quality: 80 })).src
  : undefined;

const title = `${campaign.firstName}’s Movember ${campaign.year}`;
const description = `${campaign.firstName} is growing a moustache and running tabletop games for men’s health. Follow the progress and donate through Movember.`;
---

<Base title={title} description={description} image={shareImage}>
  <div id="top"></div>
  <SiteHeader />
  <main id="main">
    <Hero latestDay={latest?.day ?? null} />
    <MoTracker />
    <Events />
    <About />
  </main>
  <SiteFooter />
</Base>
